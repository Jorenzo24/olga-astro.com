# ==========================================================================
# olga-astro.com — Apache configuration (cPanel / Hetzner)
# ==========================================================================

Options -Indexes
DirectoryIndex index.html

# --- Force HTTPS + strip www -------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # www -> non-www
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # http -> https
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- 301 de l'ancien site WordPress (contenu 100% russe) ---------------------
# olga-astro.com tournait sous WordPress avec des slugs latins et un contenu
# uniquement russe. Ces URL sont indexées : elles pointent vers les pages /ru/
# correspondantes du nouveau site. Ajouté le 2026-09-16.
# NB : /consultation/ n'est PAS redirigée, elle est désormais la page
# « Consultations » en anglais du nouveau site (hreflang renvoie vers /ru/).
<IfModule mod_rewrite.c>
    RewriteRule ^about-me/?$                                    /ru/ob-olge/ [L,R=301]
    RewriteRule ^question-answer/?$                             /ru/voprosy-otvety/ [L,R=301]
    RewriteRule ^contact/?$                                     /ru/kontakty/ [L,R=301]
    RewriteRule ^news-horoscope/?$                              /ru/stati/ [L,R=301]
    RewriteRule ^information-on-consultations/?$                /ru/konsultatsii/ [L,R=301]

    RewriteRule ^natal-astrology-personal-horoscope/?$          /ru/natalnaya-karta/ [L,R=301]
    RewriteRule ^astrological-forecast-annual-horoscope/?$      /ru/astrologicheskiy-prognoz/ [L,R=301]
    RewriteRule ^synastry-compatibility-horoscope/?$            /ru/sinastriya-sovmestimost/ [L,R=301]
    RewriteRule ^career-guidance/?$                             /ru/proforientatsiya/ [L,R=301]
    RewriteRule ^child-horoscope/?$                             /ru/detskiy-goroskop/ [L,R=301]
    RewriteRule ^relocation-horoscope-moving/?$                 /ru/relokatsiya/ [L,R=301]
    RewriteRule ^health-horoscope/?$                            /ru/goroskop-zdorovya/ [L,R=301]
    RewriteRule ^horoscope-rectification-birth-time-calculation/?$ /ru/rektifikatsiya/ [L,R=301]
    RewriteRule ^horoscope-correction-birth-time-calculation/?$    /ru/rektifikatsiya/ [L,R=301]
    RewriteRule ^situation-requiring-resolution/?$              /ru/razreshenie-situatsii/ [L,R=301]

    # Les 6 anciens articles (slugs cyrilliques encodés) : pas d'équivalent
    # unitaire sur le nouveau site, ils pointent vers l'index des articles.
    RewriteRule ^%d0%bd%d0%b5%d0%bf%d1%82%d1%83%d0%bd            /ru/stati/ [L,R=301,NE]
    RewriteRule ^%d0%b0%d1%81%d1%82%d1%80%d0%be%d0%bb%d0%be      /ru/stati/ [L,R=301,NE]
    RewriteRule ^%d1%81%d0%be%d0%b5%d0%b4%d0%b8%d0%bd            /ru/stati/ [L,R=301,NE]
    RewriteRule ^%d1%83%d1%80%d0%b0%d0%bd                        /ru/stati/ [L,R=301,NE]
    RewriteRule ^%d0%bd%d0%be%d0%b2%d1%8b%d0%b9                  /ru/stati/ [L,R=301,NE]
    RewriteRule ^%d0%be%d0%ba%d0%be%d0%bd%d1%87                  /ru/stati/ [L,R=301,NE]

    # Sitemaps Yoast de l'ancien site
    RewriteRule ^(sitemap_index|page-sitemap|post-sitemap|category-sitemap|author-sitemap)\.xml$ /sitemap.xml [L,R=301]
</IfModule>

# --- Custom error pages ------------------------------------------------------
ErrorDocument 404 /404.html

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/font-woff
</IfModule>

# --- Browser caching ---------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"

    ExpiresByType text/html                 "access plus 1 hour"

    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType text/javascript           "access plus 1 month"

    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"

    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/ttf                  "access plus 1 year"
    ExpiresByType font/otf                  "access plus 1 year"
</IfModule>

# --- Security headers --------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Cache HTML revalidation handled by Expires above; keep assets immutable
    <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>

# --- Block access to sensitive files ----------------------------------------
<FilesMatch "(^\.|\.(bak|old|log|env|yml|md|gitignore)$)">
    Require all denied
</FilesMatch>
<Files .htaccess>
    Require all denied
</Files>
