# ============================================
# OLGA ASTRO — Configuration SMTP (template)
# ============================================
# Copier ce fichier en .env et remplir les valeurs.
# Le fichier .env est ignoré par Git (voir .gitignore) et bloqué par .htaccess.
# Sur cPanel : le déposer à la main dans /home/CPANELUSER/public_html/
# Il n'est jamais poussé par le déploiement Git.

SMTP_HOST=mail.olga-astro.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=noreply@olga-astro.com
SMTP_PASS=replace_me
SMTP_FROM=noreply@olga-astro.com
SMTP_FROM_NAME="Olga Astro"
# Destinataire des demandes. Si un « manager » traite les demandes (voir la
# FAQ d'Olga), mettre son adresse ici et celle d'Olga en copie.
SMTP_TO=info@olga-astro.com
SMTP_TO_NAME="Olga Astro"
# Copies éventuelles, séparées par des virgules (optionnel)
SMTP_CC=

# ============================================
# Cloudflare Turnstile (anti-robot, optionnel)
# ============================================
# Si TURNSTILE_SECRET_KEY est vide ou reste à replace_me, send.php NE FAIT PAS
# la vérification : le formulaire continue de marcher, protégé par le honeypot,
# la limitation de débit et le filtrage de contenu. Le fait est tracé dans
# logs/spam.log pour que ce ne soit pas silencieux.
# La site key est publique et doit aussi être posée dans les 3 pages contact.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
